# ==secondary data generation==
SDGNAME sdg
SDGDIR $FSDBDIR/fsdb-$SDGNAME/scripts
SDGMACROS $FSDBDIR/fsdb-$SDGNAME/macros/fsdb.$SDGNAME
SDGINSTALL $FSDBDIR/fsdb-$SDGNAME/install

### ==TOGGLES FOR SECONDARY DATA TYPES==
GLOBAL_SDTOG 1
MIP_SDTOG 1					# <-- generates a maximum intensity projection and saves it as png
AIP_SDTOG 1					# <-- generates a average intensity projection and saves it as png
CS_SDTOG 1					# <-- extracts the slice in the middle of the stack
#TRANS_SDTOG 0				# <-- turns each slice into a frame of its output mp4
SUBSTACK_SDTOG 0			# <-- generates a stack of substack projections (extened focus) 
### ==TOGGLES FOR SECONDARY DATA EXPORTS==
GLOBAL_EXTOG 0				# <-- toggles ALL data exports on/off
NRRD_EXTOG 1				# <-- separates cahnnels and saves them in individual (compressed) nrrd files.
MHA_EXTOG 0					# <-- separates cahnnels and saves them in individual mha files.
HD5_EXTOG 0					# <-- saves in hdf5 format for BigDataViewer
### ==TOGGLES FOR IMAGE MANIPULATION==
# do not change the order of these toggles
GLOBAL_IMTOG 0				# <-- toggles ALL image-manipulation on/off (main-switch)
CROPSTACK_IMTOG 1			# <-- reduces file size by cropping to specimen
CROPHEAD_IMTOG 1			# <-- reduces file size by cropping to the left 1/3 of the specimen
CROPROT_IMTOG 1				# <-- toggles (pre-)alignment of the body-axis of the cropped head to the coordinate system
### ==TOGGLES FOR IMAGE PRE-PROCESSING==
GLOBAL_PPTOG 1				# <-- toggles ALL image-pre-processing on/off (main-switch)
COLCORR_PPTOG 1				# <-- adjusts the colomaps (for all channels) to the TPS-defaults
UNMIX_PPTOG 0               # <-- triggers channel unmixing
### ==TOGGLES FOR IMAGE PROCESSING==
NOOPT HD5 TRANS NRRD		# <-- surpresses image processing for listed output types #TODO: check if still valid 
GLOBAL_IPTOG  1				# <-- toggles ALL image-processing on/off (main-switch)
OPTIMIZECONTRAST_IPTOG 1	# keep this first in the list of IPTOGs! <-- runs "Enhance Contrast", "saturated=0.1"
SETCONTRAST_IPTOG 1			# <-- sets the dymanic range to the max (0-255/4095)
CLAHE_IPTOG 0				# <-- runs 'contrast limited adaptive histogram equalization' (sophisicated contrast enhancement) 
DESP_IPTOG 0				# <-- triggers despeckeling (in CLAHE). Possible values: 0=off;1=despeckle pre clahe;2=despeckle pre and post clahe 
### ==TOGGLES FOR IMAGE ANNOTATION==
GLOBAL_IATOG 1				# <-- toggles ALL image-annotation on/off (main-switch)
WRITECONTRAST_IATOG 1		# <-- writes the minimal and maximal displayed values into the secData (for each channel)
WRITESCALEBAR_IATOG 1		# <-- writes a scalebar into the secData (only meaningful with calibrated data)

### ==SUFFIX FOR OUTPUT DIRECTORY==
SECDATA_EXT -secData

### ==SUFFIXES FOR FILE TYPES==
MIP_SUFF .mip
AIP_SUFF .aip
CS_SUFF .cs
#TRANS_SUFF .trans	
HD5_SUFF .bdv
SUBSTACK_SUFF .sss
NRRD_SUFF .cmp
MHA_SUFF .cmp
### ==SUFFIXES FOR IMAGE PRE-PROCESSING==
COLCORR_PPSUFF -cc
CROPSTACK_PPSUFF -crp
CROPHEAD_PPSUFF -head
CROPROT_PPSUFF .rot
### ==SUFFIXES FOR IMAGE PROCESSING==
SETCONTRAST_IPSUFF .sc
OPTIMIZECONTRAST_IPSUFF .oc
CLAHE_IPSUFF .cl
### ==SUFFIXES FOR IMAGE ANNOTATION==
WRITECONTRAST_IASUFF .wc
WRITESCALEBAR_IASUFF .sb
### ==FILE TYPES FOR SEC DATA==
MIP_FT .png
AIP_FT .png
CS_FT .png
#TRANS_FT .mp4
HD5_FT .h5
SUBSTACK_FT .tif
CROPSTACK_FT .tif
CROPHEAD_FT .tif
CROPROT_FT .tif
PREPROC_FT .tif
NRRD_FT .nrrd
MHA_FT .mha

#### DO NOT MODIFY BELOW THIS POINT ####
### ==SCRIPTS==	
# ==sedcondary data generation==
SECDATAGEN $SDGDIR/runner.sh
MAKEMETA $SDGDIR/writeMetadata.sh
MAKECALLER $SDGDIR/makeCaller.sh
MAKESECDATA $SDGDIR/makeSecData.sh
#MAKESDGDIR_SRC $SDGDIR/makeSecDataDir.sh
PNG2MOV $SDGDIR/ffmpeg-png2mp4.sh	# on old systems: avconv-png2mp4.sh, otherwise ffmpeg-png2mp4.sh
REAPER $SDGDIR/reaper.sh	# <-- stops all active secondary data generation tasks
MAKETODOLIST $SDGDIR/makeTodoList.sh        # <-- make todo-list for secondary data generation
FIJIONSERVER $SDGDIR/fijiOnServer.sh
#FIJIONSERVER $CORESCRIPTS/fijiXvfb.sh 

### ==SDG INSTALLATION SCRIPTS== 
FIJI_SETUP $SDGINSTALL/setupFiji.sh

### ==MACROS==
# wrapper macros
CALLER $SDGMACROS/fsdb.$SDGNAME.caller.ijm
INITIMAGE $SDGMACROS/fsdb.sdg.initImage.ijm

# secData generating macros
MIP_MAC $SDGMACROS/fsdb.sdg.mip.ijm
AIP_MAC $SDGMACROS/fsdb.sdg.aip.ijm
CS_MAC $SDGMACROS/fsdb.sdg.cs.ijm
#TRANS_MAC $SDGMACROS/fsdb.sdg.translation.ijm
SUBSTACK_MAC $SDGMACROS/fsdb.sdg.substackstack.ijm
SAVETIF_MAC $SDGMACROS/fsdb.sdg.saveTif.ijm
SAVEPNG_MAC $SDGMACROS/fsdb.sdg.savePng.ijm

# data export macros
SAVENRRD_MAC $SDGMACROS/fsdb.sdg.saveNrrd.ijm
HD5_MAC $SDGMACROS/fsdb.sdg.hd5.ijm
MHA_MAC $SDGMACROS/fsdb.sdg.saveMha.ijm

# image processing macros
SETCONTRAST_MAC $SDGMACROS/fsdb.sdg.setContrast.ijm
OPTIMIZECONTRAST_MAC $SDGMACROS/fsdb.sdg.optimizeContrast.ijm
CLAHE_MAC $SDGMACROS/fsdb.sdg.clahe.ijm
CROPSTACK_MAC $SDGMACROS/fsdb.sdg.crop.ijm
CROPHEAD_MAC $SDGMACROS/fsdb.sdg.crop.ijm
CROPROT_MAC $SDGMACROS/fsdb.sdg.crop.ijm
COLCORR_MAC $SDGMACROS/fsdb.sdg.correctColors.ijm
DEINTERLEAVE_MAC $SDGMACROS/fsdb.sdg.deinterleaveStack.ijm
#MERGECHANNELS_MAC $SDGMACROS/fsdb.sdg.mergeChannels.ijm
#MERGECHANNELS#FUSECHANNELS_MAC $SDGMACROS/fsdb.sdg.fuseChannels.ijm
#FLIPSTACK_MAC $SDGMACROS/fsdb.sdg.flipNd2Horizontally.ijm
#FINDTHRESHOLD_MAC $SDGMACROS/fsdb.sdg.findThreshold.ijm
#SELECTBIGGESTROI_MAC $SDGMACROS/fsdb.sdg.selectBiggestROI.ijm
#HEADLEFT_MAC $SDGMACROS/fsdb.sdg.headLeft.ijm
#FINDHEAD_MAC $SDGMACROS/fsdb.sdg.findHead.ijm
#DECIDE_MAC $SDGMACROS/fsdb.sdg.makeDecision.ijm

# image annotation macros
WRITECONTRAST_MAC $SDGMACROS/fsdb.sdg.writeContrast.ijm
WRITESCALEBAR_MAC $SDGMACROS/fsdb.sdg.writeScalebar.ijm

# functional (helper) macros
SDGFUNCTIONS $SDGMACROS/fsdb.sdg.secDataFunctions.ijm


# ==cron settings==
# VARNAME_CRON m h dom mon dow user command
SDG_CRON 45 */6 * * * root ${SDGGEN}

